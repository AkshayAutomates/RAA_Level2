<Window x:Class="RAA_Level2.MyForm"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RAA_Level2"
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="650"
                    MinHeight="400"
                    MinWidth="550"
             Title ="Project Setup">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height =" 30"/>
            <RowDefinition Height =" 80"/>
            <RowDefinition Height =" 30"/>
            <RowDefinition Height =" 30"/>
            <RowDefinition Height =" 30"/>
            <RowDefinition Height =" 30"/>
            <RowDefinition Height =" 30"/>
            <RowDefinition Height =" 80"/>
            <RowDefinition Height =" 50"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="20"/>
        </Grid.ColumnDefinitions>
        <Label Grid.Row = "0" Grid.Column = "1" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="14" >Revit Addin Academy</Label>
        <TextBlock Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="36" FontWeight="Bold">Project Setup</TextBlock>
        <TextBlock Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="14" FontWeight="Bold" >Select Setup CSV File:</TextBlock>
        <TextBox x:Name="tbxSelect" Grid.Row=" 3" Grid.Column="1" Margin=" 0,0,10,0" HorizontalAlignment= "Left" VerticalAlignment="Stretch" Width="415"/>
        <Button x:Name="btnSelect" Content="Select" Grid.Row="3" Grid.Column="1" HorizontalAlignment= "Right" VerticalAlignment="Stretch" Width="100" FontSize="14" Click="btnSelect_Click"/>
        <TextBlock Grid.Row="4" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="14" FontWeight="Bold" >Select units:</TextBlock>
        <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <RadioButton x:Name="rb1" Grid.Row=" 5" Grid.Column="1" Margin=" 0,0,10,0" GroupName="Group1" IsChecked="True" > Imperial</RadioButton>
            <RadioButton x:Name="rb2" Grid.Row=" 5" Grid.Column="1" Margin=" 0,0,10,0" GroupName="Group1" >Metric</RadioButton>
        </StackPanel>
        <TextBlock Grid.Row="6" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="14" FontWeight="Bold" >Select Views to Create:</TextBlock>
        <StackPanel Grid.Row="7" Grid.Column="1" Orientation="Vertical">
            <CheckBox x:Name="cb1" Grid.Row="7" Grid.Column="1" Margin="0,10,0,10" IsChecked="True">Create Floor Plans</CheckBox>
            <CheckBox x:Name="cb2" Grid.Row="7" Grid.Column="1" Margin="0,0,0,10" IsChecked="True">Create Ceiling Plans</CheckBox>
        </StackPanel>
        <StackPanel Grid.Row="8" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="btnOK" Width="100" Height= "30" Margin="0,0,10,0" Click="btnOK_Click" >OK</Button>
            <Button x:Name="btnCancel" Width="100" Height="30" Margin="0,0,10,0" Click="btnCancel_Click" >Cancel</Button>
        </StackPanel>
    </Grid>
</Window>
